{
  "name": "cdts",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless multi-servicio CDTS",
  "scripts": {
    "deploy": "serverless-compose deploy",
    "deploy:dev": "serverless-compose deploy --stage dev",
    "remove": "serverless-compose remove",
    "logs:moc": "cd services/moc && serverless logs -f health -t",
    "logs:sign": "cd services/digital_signature && serverless logs -f sign -t"
  },
  "devDependencies": {
    "@serverless/compose": "^1.3.0"
  }
}
